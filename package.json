{
  "name": "strata",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive historical world map — explore 12,000 years of human history through toggleable data layers, from political boundaries to migrations, religions, and climate.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:cities": "node scripts/build-cities.mjs",
    "build:cities:refresh": "node scripts/build-cities.mjs --refresh",
    "build:battles": "node scripts/build-battles.mjs",
    "build:disasters": "node scripts/build-disasters.mjs",
    "build:population": "node scripts/build-population.mjs",
    "build:population:refresh": "node scripts/build-population.mjs --refresh"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "maplibre-gl": "^5.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^5.4.11"
  }
}
